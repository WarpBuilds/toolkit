{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./lib",
    "rootDir": "./src",
    "lib": [
      "es6",
      "dom"
    ],
    "useUnknownInCatchVariables": false,
    "sourceMap": true,
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/__mocks__/*",
    "./src/test.ts"
  ]
}